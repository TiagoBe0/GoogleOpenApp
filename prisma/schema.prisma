generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts            Account[]
  sessions            Session[]
  psychologistProfile PsychologistProfile?
  appointments        Appointment[]
}

model PsychologistProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  slug               String?  @unique
  specialty          String?
  licenseNumber      String?
  bio                String?
  phone              String?
  address            String?
  city               String?
  country            String?  @default("Argentina")
  yearsOfExperience  Int?
  consultationFee    Float?
  currency           String?  @default("ARS")
  languages          String?
  website            String?
  instagram          String?
  linkedin           String?
  sessionDuration    Int?     @default(50)
  modalityOnline     Boolean  @default(false)
  modalityPresential Boolean  @default(true)
  acceptsNewPatients Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// status: pending_payment | confirmed | cancelled | completed
// paymentStatus: pending | approved | rejected | in_process
model Appointment {
  id              String   @id @default(cuid())
  psychologistId  String
  patientName     String
  patientEmail    String
  patientPhone    String?
  scheduledAt     DateTime
  durationMinutes Int      @default(50)
  status          String   @default("pending_payment")
  paymentStatus   String   @default("pending")
  paymentId       String?
  preferenceId    String?
  amount          Float
  currency        String   @default("ARS")
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  psychologist User @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
