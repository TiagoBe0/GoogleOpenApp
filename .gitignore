# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (el único que se versiona es .env.example)
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
prisma/*.db
prisma/*.db-journal

# Google OAuth credentials file
client_secret_*.json
.gstack/

# Credenciales locales (nunca commitear)
credentials.txt

# Videos del portfolio de Malbec Motion: pesan, no van al repo. Se copian al
# servidor con scp (ver CLAUDE.md, "Landing de Malbec Motion").
/public/reel/
