generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("PATIENT")
  isActive      Boolean   @default(true)
  psychologistId String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  patients      User[]        @relation("PatientPsychologist")
  psychologist  User?         @relation("PatientPsychologist", fields: [psychologistId], references: [id])
  patientAppointments      Appointment[] @relation("PatientAppointments")
  psychologistAppointments Appointment[] @relation("PsychologistAppointments")
  reviewsGiven             Review[]      @relation("PatientReviews")
  reviewsReceived          Review[]      @relation("PsychologistReviews")
  psychologistProfile      PsychologistProfile?
  patientProfile           PatientProfile?
}

model Appointment {
  id              String   @id @default(cuid())
  patientId       String?
  psychologistId  String
  date            DateTime
  duration        Int      @default(60)
  notes           String?
  status          String   @default("PENDING")
  calendarEventId String?
  // anonymous patient fields (public booking via /p/[slug])
  patientName     String?
  patientEmail    String?
  patientPhone    String?
  // payment fields
  preferenceId    String?
  paymentId       String?
  paymentStatus   String?
  paymentProofUrl String?
  amount          Float?
  currency        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  patient      User? @relation("PatientAppointments", fields: [patientId], references: [id])
  psychologist User  @relation("PsychologistAppointments", fields: [psychologistId], references: [id])
}

model PsychologistProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  slug            String   @unique
  specialty       String?
  licenseNumber   String?
  bio             String?
  phone           String?
  address         String?
  city            String?
  country         String?  @default("Argentina")
  yearsOfExperience Int?
  consultationFee Float?
  currency        String   @default("ARS")
  languages       String?
  website         String?
  instagram       String?
  linkedin        String?
  sessionDuration Int      @default(50)
  timezone        String   @default("America/Argentina/Buenos_Aires")
  modalityOnline  Boolean  @default(false)
  modalityPresential Boolean @default(true)
  acceptsNewPatients Boolean @default(true)
  cbu             String?
  alias           String?
  instagramUrl    String?
  linkedinUrl     String?
  websiteUrl      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PatientProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  dni       String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Review {
  id             String   @id @default(cuid())
  rating         Int
  comment        String?
  patientId      String
  psychologistId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  patient      User @relation("PatientReviews", fields: [patientId], references: [id], onDelete: Cascade)
  psychologist User @relation("PsychologistReviews", fields: [psychologistId], references: [id], onDelete: Cascade)

  @@unique([patientId, psychologistId])
  @@index([psychologistId])
}
