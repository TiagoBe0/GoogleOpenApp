# Base de datos SQLite
DATABASE_URL="file:./dev.db"

# NextAuth - Genera uno con: openssl rand -base64 32
AUTH_SECRET="your-secret-here-change-in-production"

# Google OAuth - https://console.cloud.google.com
# 1. Crear proyecto -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# 2. Application type: Web application
# 3. Authorized redirect URIs: http://localhost:3000/api/auth/callback/google
# 4. Habilitar: Google Calendar API en APIs & Services -> Library
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

NEXTAUTH_URL="http://localhost:3000"

# MercadoPago - https://www.mercadopago.com.ar/developers/panel
# 1. Crear una aplicación
# 2. Copiar Access Token (modo TEST para desarrollo, PROD para producción)
# 3. Para el webhook en desarrollo usar ngrok: ngrok http 3000
#    y configurar la URL en MP Panel > Tu app > Webhooks
MP_ACCESS_TOKEN="TEST-xxxxxxxxxxxx-xxxxxx-xxxxxxxxxxxxxxxxxxxx-xxxxxxxxx"
MP_PUBLIC_KEY="TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
# Webhook secret — en MP Panel > Tu app > Webhooks > Clave secreta
MP_WEBHOOK_SECRET="tu-clave-secreta-del-webhook"

# Correo saliente (avisos de turno). Es SMTP a propósito: lo hablan todos los
# proveedores, así que cambiar de uno a otro es cambiar estas variables.
# Sin SMTP_HOST no se envía nada y cada aviso se escribe en la consola, que es
# como conviene trabajar en desarrollo.
#
# Gmail: host smtp.gmail.com, puerto 587, usuario tu dirección y como
#   contraseña una "contraseña de aplicación" (no la de tu cuenta), que se
#   genera en https://myaccount.google.com/apppasswords con 2FA activado.
# Resend: host smtp.resend.com, puerto 465, usuario "resend", contraseña tu
#   API key. Para enviar a cualquier destinatario hay que verificar un dominio.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="PsicoLink <turnos@tu-dominio.com>"

# Avisos push del navegador (Web Push / VAPID)
# Generar con: npx web-push generate-vapid-keys
# Sin estas variables la app no ofrece activar avisos y no envía ninguno.
# Si se rotan, las suscripciones existentes dejan de funcionar y hay que
# volver a activarlas en cada dispositivo.
VAPID_SUBJECT="mailto:tu-mail@ejemplo.com"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
