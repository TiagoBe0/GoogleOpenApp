generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("PATIENT")
  // Distingue "eligió su rol" de "quedó con el valor por defecto". Google no
  // puede preguntarlo durante el login, así que quien entra por ahí llega con
  // false y la pantalla de bienvenida se lo pregunta una sola vez.
  roleChosen    Boolean   @default(false)
  psychologistId String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  patients      User[]        @relation("PatientPsychologist")
  psychologist  User?         @relation("PatientPsychologist", fields: [psychologistId], references: [id])
  patientAppointments      Appointment[] @relation("PatientAppointments")
  psychologistAppointments Appointment[] @relation("PsychologistAppointments")
  reviewsGiven             Review[]      @relation("PatientReviews")
  reviewsReceived          Review[]      @relation("PsychologistReviews")
  psychologistProfile      PsychologistProfile?
  availability             AvailabilityRule[]
  pushSubscriptions        PushSubscription[]
}

/// Navegador registrado para recibir avisos push. Una persona puede tener
/// varios: el teléfono y la computadora del consultorio son suscripciones
/// distintas, y hay que avisarle en las dos.
model PushSubscription {
  id     String @id @default(cuid())
  userId String
  /// URL que da el navegador para empujarle el aviso. Es el identificador real
  /// de la suscripción: si el navegador la renueva, cambia.
  endpoint String @unique
  /// Claves de cifrado del navegador. El contenido del aviso viaja cifrado
  /// extremo a extremo, así que el servicio de push (Google, Mozilla) no puede
  /// leer de qué turno se trata.
  p256dh String
  auth   String

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Franja semanal recurrente en la que el profesional atiende. Un día puede
/// tener varias (mañana y tarde), y los minutos son locales a la zona horaria
/// del perfil, no UTC: la agenda de alguien que atiende "de 14 a 19" no se
/// corre cuando cambia el horario de verano.
model AvailabilityRule {
  id             String   @id @default(cuid())
  psychologistId String
  /// 0 = domingo ... 6 = sábado, igual que Date.getDay().
  weekday        Int
  /// Minutos desde la medianoche local. 480 = 08:00.
  startMinute    Int
  endMinute      Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  psychologist User @relation(fields: [psychologistId], references: [id], onDelete: Cascade)

  @@index([psychologistId])
}

model Appointment {
  id              String   @id @default(cuid())
  patientId       String?
  psychologistId  String
  date            DateTime
  duration        Int      @default(60)
  notes           String?
  status          String   @default("PENDING")
  calendarEventId String?
  /// Sube con cada reprogramación. Va en el .ics: sin un número mayor que el
  /// anterior, el cliente de calendario descarta la actualización por vieja.
  calendarSequence Int     @default(0)
  // anonymous patient fields (public booking via /p/[slug])
  patientName     String?
  patientEmail    String?
  patientPhone    String?
  // payment fields
  preferenceId    String?
  paymentId       String?
  paymentStatus   String?
  amount          Float?
  currency        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  patient      User? @relation("PatientAppointments", fields: [patientId], references: [id])
  psychologist User  @relation("PsychologistAppointments", fields: [psychologistId], references: [id])
}

model PsychologistProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  slug            String   @unique
  specialty       String?
  licenseNumber   String?
  bio             String?
  consultationFee Float?
  currency        String   @default("ARS")
  sessionDuration Int      @default(50)
  timezone        String   @default("America/Argentina/Buenos_Aires")
  instagramUrl    String?
  linkedinUrl     String?
  websiteUrl      String?

  // Datos de contacto y consultorio. El formulario de perfil ya los pedía
  // desde el principio, pero no existían acá: se completaban, decía "guardado
  // correctamente" y se perdían al recargar.
  phone              String?
  address            String?
  city               String?
  country            String?
  yearsOfExperience  Int?
  /// Idiomas separados por coma, tal como los escribe el profesional.
  languages          String?
  modalityOnline     Boolean @default(false)
  modalityPresential Boolean @default(true)
  /// En false el perfil sale del directorio público, pero su link directo
  /// sigue funcionando: sirve para quien tiene la agenda llena.
  acceptsNewPatients Boolean @default(true)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Review {
  id             String   @id @default(cuid())
  rating         Int
  comment        String?
  patientId      String
  psychologistId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  patient      User @relation("PatientReviews", fields: [patientId], references: [id], onDelete: Cascade)
  psychologist User @relation("PsychologistReviews", fields: [psychologistId], references: [id], onDelete: Cascade)

  @@unique([patientId, psychologistId])
  @@index([psychologistId])
}
