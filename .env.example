# Base de datos SQLite
DATABASE_URL="file:./dev.db"

# NextAuth - Genera uno con: openssl rand -base64 32
AUTH_SECRET="your-secret-here-change-in-production"

# Google OAuth - https://console.cloud.google.com
# 1. Crear proyecto -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# 2. Application type: Web application
# 3. Authorized redirect URIs: http://localhost:3000/api/auth/callback/google
# 4. Habilitar: Google Calendar API en APIs & Services -> Library
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

NEXTAUTH_URL="http://localhost:3000"
