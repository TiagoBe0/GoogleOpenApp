generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts           Account[]
  sessions           Session[]
  psychologistProfile PsychologistProfile?
}

model PsychologistProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  specialty           String?  // Especialidad principal
  licenseNumber       String?  // Número de matrícula / colegiado
  bio                 String?  // Descripción profesional
  phone               String?
  address             String?  // Dirección del consultorio
  city                String?
  country             String?  @default("Argentina")
  yearsOfExperience   Int?
  consultationFee     Float?   // Precio de consulta (moneda local)
  currency            String?  @default("ARS")
  languages           String?  // Idiomas separados por coma
  website             String?
  instagram           String?
  linkedin            String?
  sessionDuration     Int?     // Duración de sesión en minutos
  modalityOnline      Boolean  @default(false)
  modalityPresential  Boolean  @default(true)
  acceptsNewPatients  Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
